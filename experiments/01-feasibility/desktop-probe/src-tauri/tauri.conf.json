{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laplace Feasibility Probe",
  "version": "0.0.0",
  "identifier": "dev.laplace.feasibility",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Laplace — ticket 01 feasibility probe", "width": 1440, "height": 900 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
