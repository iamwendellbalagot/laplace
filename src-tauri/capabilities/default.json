{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Laplace window capability for native folder selection.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "opener:allow-open-url"
  ]
}
